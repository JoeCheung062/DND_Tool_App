{
  "name": "dnd-server-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DND Server — local API, CMS, and database for DND App",
  "author": "DND App",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "stage": "node scripts/stage.mjs",
    "build": "node scripts/build.mjs",
    "dist": "npm run stage && npm run build && electron-builder --mac dmg zip --arm64 --x64 --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.0"
  },
  "build": {
    "appId": "com.dndapp.server",
    "productName": "DND Server",
    "copyright": "Copyright © DND App",
    "directories": {
      "output": "release",
      "buildResources": "../app/build"
    },
    "files": [
      "dist-electron/**/*",
      "electron/status.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bundle/dist",
        "to": "bundle/dist"
      },
      {
        "from": "bundle/prisma",
        "to": "bundle/prisma"
      },
      {
        "from": "bundle/cms",
        "to": "bundle/cms"
      },
      {
        "from": "bundle/package.json",
        "to": "bundle/package.json"
      },
      {
        "from": "bundle/docker-compose.yml",
        "to": "bundle/docker-compose.yml"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "asar": true,
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools",
      "icon": "../app/build/icon.png"
    },
    "win": {
      "target": ["nsis"],
      "icon": "../app/build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
