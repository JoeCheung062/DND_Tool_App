generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "darwin", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// CMS / system admin roles (login accounts)
enum AdminRole {
  SUPER_ADMIN
  ADMIN
  DM
}

/// Material Slide type: Image / Effect / Sound
enum MaterialType {
  IMAGE
  EFFECT
  SOUND
}

enum CombinationCategory {
  STANDARD
  ENVIRONMENT_PACK
}

model Room {
  id         String    @id @default(cuid())
  name       String
  /// Selected script (Campaign) for this play session
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  /// Control layout: zones, map, and initiative. The server is the source of truth.
  session    Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([campaignId])
}

model Campaign {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Materials preset into this campaign (many-to-many)
  materialPresets MaterialCampaignPreset[]
  /// Rooms using this campaign as their script
  rooms           Room[]
}

/// Player / table users — no login credentials (cannot sign in)
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String   @unique

  /// User Profile
  displayName String?
  avatarUrl   String?
  bio         String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  characters  Character[]
}

/// Admin login accounts — Super Admin / Admin / DM
model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)

  displayName  String?
  avatarUrl    String?
  bio          String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Character {
  id           String   @id @default(cuid())
  name         String
  /// Character illustration (image URL / path)
  illustration String?
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materials MaterialTag[]
}

/// Material Slide — Image / Effect / Sound assets
model Material {
  id        String       @id @default(cuid())
  /// IMAGE | EFFECT | SOUND
  type      MaterialType
  name      String
  /// Available to every campaign (downloaded with any room's campaign)
  general   Boolean  @default(false)
  /// Map avatar that also places Character Art into a zone
  npc       Boolean  @default(false)
  /// Full-body art shown in a zone when this NPC stands in that zone's scene area
  characterArtUrl String?
  /// URL or path to the image / effect / sound file
  assetUrl  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  /// Presets In Campaign (multiple selections)
  campaignPresets MaterialCampaignPreset[]
  /// Tags (multiple selections)
  tags            MaterialTag[]

  /// Combinations where this is the main material
  mainCombinations Combination[] @relation("MainMaterial")
  /// Combinations where this is a connected material
  connectLinks     CombinationConnect[]
  zone1Combinations Combination[] @relation("Zone1Material")
  zone2Combinations Combination[] @relation("Zone2Material")
  zone3Combinations Combination[] @relation("Zone3Material")
  zone4Combinations Combination[] @relation("Zone4Material")
}

/// Join: Material ↔ Campaign (presets, many-to-many)
model MaterialCampaignPreset {
  materialId String
  campaignId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([materialId, campaignId])
  @@index([campaignId])
}

/// Join: Material ↔ Tag (many-to-many)
model MaterialTag {
  materialId String
  tagId      String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([materialId, tagId])
  @@index([tagId])
}

/// Combination of materials for a scene / slide stack
model Combination {
  id             String                @id @default(cuid())
  name           String
  /// Optional. Environment packs assign one image to each zone instead of a main material.
  category       CombinationCategory   @default(STANDARD)
  /// Main material (single). Unused for an environment pack.
  mainMaterialId String?
  mainMaterial   Material?             @relation("MainMaterial", fields: [mainMaterialId], references: [id], onDelete: SetNull)
  zone1MaterialId String?
  zone2MaterialId String?
  zone3MaterialId String?
  zone4MaterialId String?
  zone1Material   Material?            @relation("Zone1Material", fields: [zone1MaterialId], references: [id], onDelete: SetNull)
  zone2Material   Material?            @relation("Zone2Material", fields: [zone2MaterialId], references: [id], onDelete: SetNull)
  zone3Material   Material?            @relation("Zone3Material", fields: [zone3MaterialId], references: [id], onDelete: SetNull)
  zone4Material   Material?            @relation("Zone4Material", fields: [zone4MaterialId], references: [id], onDelete: SetNull)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  /// Connect materials (multiple selections)
  connectMaterials CombinationConnect[]

  @@index([mainMaterialId])
  @@index([zone1MaterialId])
  @@index([zone2MaterialId])
  @@index([zone3MaterialId])
  @@index([zone4MaterialId])
}

/// Join: Combination ↔ connected Materials (many-to-many)
model CombinationConnect {
  combinationId String
  materialId    String
  combination   Combination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  material      Material    @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([combinationId, materialId])
  @@index([materialId])
}
