# Server
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# PostgreSQL (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dnd_app?schema=public

# JWT (required — use a long random secret in production)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Local image uploads (default when S3 is disabled)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Optional S3 storage — set S3_ENABLED=true and fill the rest to use S3 instead of local disk
S3_ENABLED=false
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=          # optional (MinIO / R2 / custom)
# S3_PUBLIC_URL=        # optional CDN or public base URL
